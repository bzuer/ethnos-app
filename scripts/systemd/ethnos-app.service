[Unit]
Description=Ethnos App
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/app
EnvironmentFile=-/etc/next-frontend.env
EnvironmentFile=-%h/app/config/env/next-frontend.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/env bash -lc 'cd "%h/app" && exec ./scripts/manage.sh start_foreground'
Restart=on-failure
RestartSec=3
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=20

[Install]
WantedBy=default.target
